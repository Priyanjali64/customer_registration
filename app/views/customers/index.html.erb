<style>
  .customers-page { min-height: 100vh; padding: 48px 24px; color: #24304a; background: linear-gradient(135deg, #f6f0ff, #e8f9ff); font-family: Arial, sans-serif; }
  .customers-header { display: flex; justify-content: space-between; align-items: center; max-width: 1100px; margin: 0 auto 32px; }
  .customers-header h1 { margin: 0; font-size: 2.5rem; color: #5527a5; }
  .customers-header p { margin: 8px 0 0; color: #68738a; }
  .new-customer { padding: 13px 20px; border-radius: 12px; color: #fff; background: #7c3aed; text-decoration: none; font-weight: bold; box-shadow: 0 8px 18px #7c3aed44; }
  .new-customer:hover { background: #6425c0; }
  .customers-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 22px; max-width: 1100px; margin: 0 auto; }
  .customers-toolbar { display: flex; gap: 12px; align-items: center; max-width: 1100px; margin: 0 auto 22px; }
  .customer-search { flex: 1; min-width: 0; padding: 13px 16px; border: 1px solid #d9d5e8; border-radius: 12px; color: #24304a; background: #fff; font-size: 1rem; }
  .customer-count { margin: 0; color: #68738a; white-space: nowrap; font-size: .95rem; }
  .pagination { display: flex; justify-content: center; align-items: center; gap: 14px; max-width: 1100px; margin: 28px auto 0; }
  .pagination button { padding: 9px 15px; border: 0; border-radius: 9px; color: #fff; background: #7c3aed; cursor: pointer; }
  .pagination button:disabled { background: #c8c2d8; cursor: not-allowed; }
  .page-number { color: #68738a; font-size: .95rem; }
  .customer-card { overflow: hidden; border: 1px solid #ffffff; border-radius: 20px; background: #ffffffdd; box-shadow: 0 12px 30px #39468418; }
  .card-top { padding: 22px; background: linear-gradient(135deg, #ede3ff, #dff8ff); }
  .card-top h3 { margin: 0; color: #402080; font-size: 1.3rem; }
  .card-details { padding: 18px 22px; }
  .card-details p { margin: 10px 0; color: #5e6980; }
  .card-details strong { color: #283653; }
  .document { margin-top: 16px; padding-top: 14px; border-top: 1px solid #e9e5f3; }
  .document img { display: block; width: 100%; max-height: 220px; object-fit: cover; border-radius: 12px; }
  .empty-document { color: #9a6b22 !important; }
  @media (max-width: 600px) { .customers-header { display: block; } .new-customer { display: inline-block; margin-top: 18px; } }
  @media (max-width: 600px) { .customers-toolbar { display: block; } .customer-count { margin-top: 9px; } }
</style>

<main class="customers-page">
  <header class="customers-header">
    <div>
      <h1>Customers</h1>
      <p>Manage your registered customers in one place.</p>
    </div>
    <%= link_to "＋ Register New Customer", new_customer_path, class: "new-customer" %>
  </header>

  <div class="customers-toolbar">
    <input class="customer-search" id="customer-search" type="search" placeholder="Search customers by name, ID, phone..." aria-label="Search customers">
    <p class="customer-count" id="customer-count"><%= pluralize(@customers.size, "customer") %></p>
  </div>

  <section class="customers-grid" id="customers-grid">
    <% @customers.each do |customer| %>
      <article class="customer-card" data-search="<%= [customer.full_name, customer.id_number, customer.phone].join(' ').downcase %>">
        <div class="card-top">
          <h3><%= customer.full_name %></h3>
        </div>
        <div class="card-details">
          <p><strong>ID:</strong> <%= customer.id_number %></p>
          <p><strong>Date of Birth:</strong> <%= customer.date_of_birth %></p>
          <p><strong>Phone:</strong> <%= customer.phone %></p>

          <%= link_to "Delete",
              customer_path(customer),
              data: {
                turbo_method: :delete,
                turbo_confirm: "Are you sure you want to delete this customer?"
              },
              class: "delete-button" %>

          <div class="document">
            <% if customer.id_document.attached? %>
              <p><strong>ID Document</strong></p>
              <%= image_tag customer.id_document, alt: "ID document for #{customer.full_name}" %>
            <% else %>
              <p class="empty-document">No ID document uploaded.</p>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </section>
  <nav class="pagination" aria-label="Customer pages">
    <button type="button" id="previous-page">Previous</button>
    <span class="page-number" id="page-number"></span>
    <button type="button" id="next-page">Next</button>
  </nav>
</main>

<script>
  (() => {
    const cards = [...document.querySelectorAll('.customer-card')];
    const search = document.getElementById('customer-search');
    const count = document.getElementById('customer-count');
    const pageNumber = document.getElementById('page-number');
    const previous = document.getElementById('previous-page');
    const next = document.getElementById('next-page');
    const pageSize = 24;
    let page = 0;
    let matches = cards;

    const render = () => {
      const pages = Math.max(1, Math.ceil(matches.length / pageSize));
      page = Math.min(page, pages - 1);
      cards.forEach(card => { card.hidden = true; });
      matches.slice(page * pageSize, (page + 1) * pageSize).forEach(card => { card.hidden = false; });
      count.textContent = `${matches.length} ${matches.length === 1 ? 'customer' : 'customers'}`;
      pageNumber.textContent = `Page ${page + 1} of ${pages}`;
      previous.disabled = page === 0;
      next.disabled = page >= pages - 1;
    };

    search.addEventListener('input', () => {
      const term = search.value.trim().toLowerCase();
      matches = cards.filter(card => card.dataset.search.includes(term));
      page = 0;
      render();
    });
    previous.addEventListener('click', () => { page--; render(); });
    next.addEventListener('click', () => { page++; render(); });
    render();
  })();
</script>


<style>
	.customer-registration { min-height: 100vh; padding: 48px 20px; background: linear-gradient(135deg, #f5f7ff, #eefaf8); color: #172033; }
	.customer-registration__shell { max-width: 760px; margin: 0 auto; }
	.customer-registration__heading { margin-bottom: 24px; }
	.customer-registration__eyebrow { margin: 0 0 8px; color: #5965d8; font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
	.customer-registration h1 { margin: 0; font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -.04em; }
	.customer-registration__subtitle { margin: 10px 0 0; color: #68738a; }
	.customer-card { padding: clamp(24px, 5vw, 42px); border: 1px solid rgba(255,255,255,.8); border-radius: 24px; background: rgba(255,255,255,.88); box-shadow: 0 20px 60px rgba(45,55,100,.12); backdrop-filter: blur(12px); }
	.customer-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
	.form-group { display: flex; flex-direction: column; gap: 8px; }
	.form-group--wide, .form-actions { grid-column: 1 / -1; }
	.form-group label { color: #35405a; font-size: .9rem; font-weight: 700; }
	.form-group input, .form-group textarea { box-sizing: border-box; width: 100%; border: 1px solid #dce1ed; border-radius: 12px; padding: 13px 14px; background: #fbfcff; color: #172033; font: inherit; transition: border-color .2s, box-shadow .2s; }
	.form-group textarea { min-height: 104px; resize: vertical; }
	.form-group input:focus, .form-group textarea:focus { outline: none; border-color: #5965d8; box-shadow: 0 0 0 4px rgba(89,101,216,.12); }
	.form-group input[type="file"] { padding: 10px; border-style: dashed; }
	.form-actions { display: flex; align-items: center; justify-content: flex-end; gap: 12px; margin-top: 8px; padding-top: 24px; border-top: 1px solid #edf0f6; }
	.form-actions input, .form-actions .button { border: 0; border-radius: 11px; padding: 13px 20px; font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
	.form-actions input { background: #5965d8; color: #fff; box-shadow: 0 8px 18px rgba(89,101,216,.24); }
	.form-actions .button.secondary { background: #eef0f7; color: #4d5870; }
	@media (max-width: 600px) { .customer-registration { padding: 28px 14px; } .customer-form { grid-template-columns: 1fr; gap: 18px; } .form-group--wide, .form-actions { grid-column: auto; } .form-actions { flex-direction: column-reverse; align-items: stretch; } .form-actions input, .form-actions .button { text-align: center; } }
</style>



<main class="customer-registration">
	<div class="customer-registration__shell">
		<header class="customer-registration__heading">
			<p class="customer-registration__eyebrow">Customer portal</p>
			<h1>Register customer</h1>
			<p class="customer-registration__subtitle">Add a new customer profile securely and quickly.</p>
		</header>

		<section class="customer-card">
			<% if @customer.errors.any? %>
				<div class="form-errors">
					<strong>Please fix the following errors:</strong>
					<ul>
						<% @customer.errors.full_messages.each do |message| %>
							<li><%= message %></li>
						<% end %>
					</ul>
				</div>
			<% end %>

			<%= form_with model: @customer, multipart: true, class: "customer-form" do |form| %>
				<div class="form-group">
					<%= form.label :full_name, "Full Name" %>
					<%= form.text_field :full_name, placeholder: "Enter full name", required: true %>
				</div>

				<div class="form-group">
					<%= form.label :id_number, "ID Number" %>
					<%= form.text_field :id_number, placeholder: "Enter ID number", required: true %>
				</div>

				<div class="form-group">
					<%= form.label :date_of_birth, "Date of Birth" %>
					<%= form.date_field :date_of_birth, required: true %>
				</div>

				<div class="form-group">
					<%= form.label :phone, "Phone" %>
					<%= form.telephone_field :phone, placeholder: "+1 (555) 000-0000", required: true %>
				</div>

				<div class="form-group form-group--wide">
					<%= form.label :address, "Address" %>
					<%= form.text_area :address, placeholder: "Enter residential address", required: true %>
				</div>

				<div class="form-group form-group--wide">
					<%= form.label :id_document, "ID Document" %>
					<%= form.file_field :id_document,
    accept: "image/png,image/jpeg",
    required: true %>
				</div>

				<div class="form-actions">
					<%= link_to "Cancel", customers_path, class: "button secondary" %>
					<%= form.submit "Register Customer" %>
				</div>
			<% end %>
		</section>
	</div>
</main>

<main class="customer-registration">
  <div class="customer-registration__shell">
    <header class="customer-registration__heading">
      <p class="customer-registration__eyebrow">Customer portal</p>
      <h1>Register customer</h1>
      <p class="customer-registration__subtitle">Add a new customer profile securely and quickly.</p>
    </header>

    <section class="customer-registration__card">
      <% if @customer.errors.any? %>
        <div class="form-errors">
          <strong>Please fix the following errors:</strong>
          <ul>
            <% @customer.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @customer, multipart: true, class: "customer-form" do |form| %>
        <div class="form-group">
          <%= form.label :full_name, "Full Name" %>
          <%= form.text_field :full_name, placeholder: "Enter full name", required: true %>
        </div>

        <div class="form-group">
          <%= form.label :id_number, "ID Number" %>
          <%= form.text_field :id_number, placeholder: "Enter ID number", required: true %>
        </div>

        <div class="form-group">
          <%= form.label :date_of_birth, "Date of Birth" %>
          <%= form.date_field :date_of_birth, required: true %>
        </div>

        <div class="form-group">
          <%= form.label :phone, "Phone" %>
          <%= form.telephone_field :phone, placeholder: "+1 (555) 000-0000", required: true %>
        </div>

        <div class="form-group form-group--wide">
          <%= form.label :address, "Address" %>
          <%= form.text_area :address, placeholder: "Enter residential address", required: true %>
        </div>

        <div class="form-group form-group--wide">
          <%= form.label :id_document, "ID Document" %>
          <%= form.file_field :id_document, accept: "image/png,image/jpeg", required: true %>
        </div>

        <div class="form-actions">
          <%= link_to "Cancel", customers_path, class: "button secondary" %>
          <%= form.submit "Register Customer" %>
        </div>
      <% end %>
    </section>
  </div>
</main>
